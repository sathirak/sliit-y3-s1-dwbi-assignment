      DTS:ObjectName="localhost.CarSalesDW">
      <DTS:ObjectData>
        <DTS:ConnectionManager
          DTS:ConnectionString="Data Source=localhost;Initial Catalog=CarSalesDW;Integrated Security=True;TrustServerCertificate=True;Application Name=SSIS-Package-{A188CBF6-3B6E-465B-AA34-48E7909B3F56}localhost.CarSalesDW;" />
      </DTS:ObjectData>
    </DTS:ConnectionManager>
  </DTS:ConnectionManagers>
  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\01_Load_Staging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{044C6F17-9C90-4CF1-BDCA-45EA3C3A447B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="01_Load_Staging"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A188CBF6-3B6E-465B-AA34-48E7909B3F56}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE stg.stg_sales;&#xA;TRUNCATE TABLE stg.stg_customer;&#xA;&#xA;&#xA;INSERT INTO stg.stg_sales (&#xA;    sale_date,&#xA;    customer_name,&#xA;    car_make,&#xA;    car_model,&#xA;    car_year,&#xA;    sale_price,&#xA;    commission_earned&#xA;)&#xA;SELECT&#xA;    TRY_CONVERT(DATE, [Date]) AS sale_date,&#xA;    NULL AS customer_name,&#xA;    [Car_Make] AS car_make,&#xA;    [Car_Model] AS car_model,&#xA;    [Car_Year] AS car_year,&#xA;    [Sale_Price] AS sale_price,&#xA;    [Commission_Earned] AS commission_earned&#xA;FROM CarSalesOLTP.dbo.source_sql_sales&#xA;WHERE TRY_CONVERT(DATE, [Date]) IS NOT NULL;&#xA;&#xA;&#xA;INSERT INTO stg.stg_customer (customer_name, region)&#xA;SELECT&#xA;    [Customer_Name] AS customer_name,&#xA;    [Region] AS region&#xA;FROM CarSalesOLTP.dbo.source_customer_master;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\02_Load_Dimennsions"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{830E05AD-A788-4DE2-A41D-52ACBC3980D4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="02_Load_Dimennsions"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A188CBF6-3B6E-465B-AA34-48E7909B3F56}"
          SQLTask:SqlStatementSource="MERGE dbo.dim_vehicle AS tgt&#xA;USING (&#xA;    SELECT DISTINCT&#xA;        CONCAT(car_make, '|', car_model, '|', car_year) AS vehicle_nk,&#xA;        car_make,&#xA;        car_model,&#xA;        car_year&#xA;    FROM stg.stg_sales&#xA;) AS src&#xA;ON tgt.vehicle_nk = src.vehicle_nk&#xA;WHEN MATCHED AND (&#xA;    tgt.car_make &lt;&gt; src.car_make OR&#xA;    tgt.car_model &lt;&gt; src.car_model OR&#xA;    tgt.car_year &lt;&gt; src.car_year&#xA;)&#xA;THEN UPDATE SET&#xA;    tgt.car_make = src.car_make,&#xA;    tgt.car_model = src.car_model,&#xA;    tgt.car_year = src.car_year,&#xA;    tgt.record_update_dtm = SYSUTCDATETIME()&#xA;WHEN NOT MATCHED BY TARGET&#xA;THEN INSERT (vehicle_nk, car_make, car_model, car_year)&#xA;     VALUES (src.vehicle_nk, src.car_make, src.car_model, src.car_year);&#xA;&#xA;&#xA;/* 2B) Close current customer rows if region changed */&#xA;;WITH src AS (&#xA;    SELECT customer_name AS customer_nk, customer_name, region&#xA;    FROM stg.stg_customer&#xA;    GROUP BY customer_name, region&#xA;)&#xA;UPDATE d&#xA;SET d.effective_to = DATEADD(SECOND, -1, SYSUTCDATETIME()),&#xA;    d.is_current = 0,&#xA;    d.record_update_dtm = SYSUTCDATETIME()&#xA;FROM dbo.dim_customer d&#xA;JOIN src s&#xA;    ON d.customer_nk = s.customer_nk&#xA;WHERE d.is_current = 1&#xA;  AND d.region &lt;&gt; s.region;&#xA;&#xA;&#xA;/* 2C) Insert new current customer rows (new or changed region) */&#xA;;WITH src AS (&#xA;    SELECT customer_name AS customer_nk, customer_name, region&#xA;    FROM stg.stg_customer&#xA;    GROUP BY customer_name, region&#xA;),&#xA;current_dim AS (&#xA;    SELECT customer_nk, region&#xA;    FROM dbo.dim_customer&#xA;    WHERE is_current = 1&#xA;)&#xA;INSERT INTO dbo.dim_customer (&#xA;    customer_nk, customer_name, region,&#xA;    effective_from, effective_to, is_current&#xA;)&#xA;SELECT&#xA;    s.customer_nk,&#xA;    s.customer_name,&#xA;    s.region,&#xA;    SYSUTCDATETIME(),&#xA;    '9999-12-31',&#xA;    1&#xA;FROM src s&#xA;LEFT JOIN current_dim c&#xA;    ON s.customer_nk = c.customer_nk&#xA;WHERE c.customer_nk IS NULL&#xA;   OR c.region &lt;&gt; s.region;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\03_Load_Fact"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{95234794-F898-4911-BA53-1679A5CE127C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="03_Load_Fact"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A188CBF6-3B6E-465B-AA34-48E7909B3F56}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.fact_sales (&#xA;    txn_id,&#xA;    date_key,&#xA;    vehicle_key,&#xA;    customer_key,&#xA;    sale_amount,&#xA;    commission_amount,&#xA;    accm_txn_create_time&#xA;)&#xA;SELECT&#xA;    s.txn_id,&#xA;    CONVERT(INT, FORMAT(s.sale_date, 'yyyyMMdd')) AS date_key,&#xA;    ISNULL(v.vehicle_key, 0) AS vehicle_key,&#xA;    ISNULL(c.customer_key, 0) AS customer_key,&#xA;    s.sale_price,&#xA;    s.commission_earned,&#xA;    SYSUTCDATETIME()&#xA;FROM stg.stg_sales s&#xA;LEFT JOIN dbo.dim_vehicle v&#xA;    ON v.vehicle_nk = CONCAT(s.car_make, '|', s.car_model, '|', s.car_year)&#xA;LEFT JOIN dbo.dim_customer c&#xA;    ON c.customer_nk = s.customer_name&#xA;   AND c.is_current = 1&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1 FROM dbo.fact_sales f WHERE f.txn_id = s.txn_id&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\04_Load_AccumulatingFact"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{4AF07213-980F-4300-B34A-2780DB12B893}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="04_Load_AccumulatingFact"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A188CBF6-3B6E-465B-AA34-48E7909B3F56}"
          SQLTask:SqlStatementSource="IF COL_LENGTH('dbo.fact_sales', 'accm_txn_create_time') IS NULL&#xA;    ALTER TABLE dbo.fact_sales ADD accm_txn_create_time DATETIME2 NOT NULL DEFAULT SYSUTCDATETIME();&#xA;&#xA;&#xA;IF COL_LENGTH('dbo.fact_sales', 'accm_txn_complete_time') IS NULL&#xA;    ALTER TABLE dbo.fact_sales ADD accm_txn_complete_time DATETIME2 NULL;&#xA;&#xA;&#xA;IF COL_LENGTH('dbo.fact_sales', 'txn_process_time_hours') IS NULL&#xA;    ALTER TABLE dbo.fact_sales ADD txn_process_time_hours DECIMAL(18,2) NULL;&#xA;&#xA;&#xA;/* Update completion timestamp + process hours */&#xA;UPDATE f&#xA;SET&#xA;    f.accm_txn_complete_time = u.accm_txn_complete_time,&#xA;    f.txn_process_time_hours =&#xA;        CASE&#xA;            WHEN u.accm_txn_complete_time &gt;= f.accm_txn_create_time&#xA;            THEN CAST(DATEDIFF(MINUTE, f.accm_txn_create_time, u.accm_txn_complete_time) / 60.0 AS DECIMAL(18,2))&#xA;            ELSE NULL&#xA;        END&#xA;FROM dbo.fact_sales f&#xA;JOIN stg.stg_fact_completion_update u&#xA;    ON f.txn_id = u.txn_id;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
