    <DTS:Executable
      DTS:refId="Package\03_Update_accum_fact"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{4B145A68-C2EA-43E6-A0D1-D1AB33313C67}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="03_Update_accum_fact"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A1DF20A0-E5EF-4CB7-812E-BE2C5CC08CAE}"
          SQLTask:SqlStatementSource="UPDATE f SET f.accm_txn_complete_time=u.accm_txn_complete_time, f.txn_process_time_hours=CASE WHEN u.accm_txn_complete_time&gt;=f.accm_txn_create_time THEN CAST(DATEDIFF(MINUTE,f.accm_txn_create_time,u.accm_txn_complete_time)/60.0 AS DECIMAL(18,2)) ELSE NULL END FROM dbo.fact_sales f JOIN stg.stg_fact_completion_update u ON f.txn_id=u.txn_id;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\04_Log_Missing_Txn"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9AE2EFBB-5F4D-4D3C-AD3F-FB0054FEE4BE}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="04_Log_Missing_Txn"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A1DF20A0-E5EF-4CB7-812E-BE2C5CC08CAE}"
          SQLTask:SqlStatementSource="IF OBJECT_ID('stg.stg_fact_completion_missing','U') IS NULL CREATE TABLE stg.stg_fact_completion_missing (txn_id BIGINT NOT NULL, accm_txn_complete_time DATETIME2 NOT NULL, logged_dtm DATETIME2 NOT NULL DEFAULT SYSUTCDATETIME());&#xA;INSERT INTO stg.stg_fact_completion_missing (txn_id, accm_txn_complete_time) SELECT u.txn_id,u.accm_txn_complete_time FROM stg.stg_fact_completion_update u LEFT JOIN dbo.fact_sales f ON f.txn_id=u.txn_id WHERE f.txn_id IS NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
